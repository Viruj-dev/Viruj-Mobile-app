# All mobile APIs and authentication are served by viruj-backend (port 4000).
# Android emulator: http://10.0.2.2:4000
# Physical phone: http://YOUR_COMPUTER_LAN_IP:4000
# Expo web: http://localhost:4000
# Without an override, native development uses the Expo LAN host on port 4000.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
# Production API must use HTTPS. These provider identifiers are public, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_ENABLE_FACEBOOK_SIGN_IN=false

# Optional offline design review only; leave disabled for real backend data.
EXPO_PUBLIC_ENABLE_UI_PREVIEW=false

# Local testing only. Release builds ignore this.
EXPO_PUBLIC_MOBILE_DEV_AUTH_BYPASS=false
