# All mobile APIs and authentication are served by viruj-backend (port 4000).
# Android emulator: http://10.0.2.2:4000
# Physical phone: http://YOUR_COMPUTER_LAN_IP:4000
# Expo web: http://localhost:4000
# Without an override, native development uses the Expo LAN host on port 4000.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
# Production must use HTTPS. Never put MSG91 credentials in this app.
